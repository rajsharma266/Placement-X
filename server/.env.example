PORT=<port>
NODE_ENV=<environment>
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
CLIENT_URL=<allowed-client-origin>
JWT_SECRET=<long-random-jwt-secret>
JWT_EXPIRES_IN=<token-expiration>
RATE_LIMIT_WINDOW_MS=<rate-limit-window-in-milliseconds>
RATE_LIMIT_MAX=<general-requests-per-window>
AUTH_RATE_LIMIT_MAX=<auth-requests-per-window>
CODE_EXECUTION_PROVIDER_URL=<sandboxed-judge-adapter-url>
CODE_EXECUTION_PROVIDER_TOKEN=<optional-judge-adapter-token>
AI_PROVIDER=<optional-provider-name>
AI_API_KEY=<optional-provider-key>
MENTOR_RATE_LIMIT_MAX=<mentor-requests-per-15-minutes>
